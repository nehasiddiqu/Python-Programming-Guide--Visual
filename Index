.op code{color:var(--muted)}.op b{font:700 22px var(--mono)}.op b.bad{color:var(--bad);font-size:15px}.op small{color:var(--blue);font-weight:700;font-size:12px}
.hops{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.hop{border:2px solid var(--line);border-radius:10px;padding:8px 12px;display:grid;font:600 15px var(--mono);animation:lit .4s var(--d,0s) both;background:var(--bg)}
.hop small{font:12px var(--body);color:var(--muted)}
.hop.yes{border-color:var(--ok)}.hop.no{opacity:.8}
.arr{color:var(--muted)}
