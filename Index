<style>
/* Layout: sticky lesson index on the left, one lesson per row, each lesson = short text + a runnable-looking demo (code on one side, state on the other). */
:root{
  --bg:#F3F5F9; --panel:#FFFFFF; --ink:#101A2E; --muted:#56627A; --line:#D6DDEA;
  --blue:#2F6DB5; --on-blue:#FFFFFF; --hl:#FFD43B; --on-hl:#1A1500;
  --ok:#1B7F54; --bad:#C0352D;
  --code:#0F1A2E; --code-ink:#E6ECF8; --tk:#8CB8FF; --ts:#8EE0B0; --tn:#FFB86B; --tc:#8D9AB5; --no:#6E7C98;
  --display:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif;
