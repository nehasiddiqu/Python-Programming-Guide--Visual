.btn:hover{border-color:var(--blue)}
.btn.primary{background:var(--blue);border-color:var(--blue);color:var(--on-blue)}
.btn:focus-visible,input:focus-visible{outline:3px solid var(--hl);outline-offset:2px}
.btn.sel{background:var(--hl);border-color:var(--hl);color:var(--on-hl)}
