nav.side a{color:var(--ink);text-decoration:none;font-size:14px;padding:4px 10px;border-radius:999px;border:1px solid var(--line);background:var(--panel)}
nav.side a[aria-current="true"]{background:var(--blue);border-color:var(--blue);color:var(--on-blue)}
nav.side a:focus-visible{outline:3px solid var(--hl);outline-offset:2px}
@media(min-width:1000px){
  nav.side{display:block;position:sticky;top:24px;align-self:start;max-height:calc(100vh - 48px);overflow:auto;padding:0}
