function stepper(mount,cfg){
  mount.innerHTML='<div class="demo"><div class="demo-grid"><div class="code" tabindex="0" aria-label="Code">'+codeHTML(cfg.code)+'</div><div class="stage"><div class="vis" aria-live="polite"></div><p class="note"></p></div></div><div class="ctl"><button class="btn primary" data-a="play">Play</button><button class="btn" data-a="prev">Back</button><button class="btn" data-a="next">Step</button><button class="btn" data-a="reset">Reset</button><span class="pos"></span></div></div>';
  const lines=[...mount.querySelectorAll('.ln')],vis=$('.vis',mount),note=$('.note',mount),pos=$('.pos',mount),play=$('[data-a=play]',mount);
  const last=cfg.steps.length-1;let i=0,timer=null;
  function show(k){
    i=k;const s=cfg.steps[k],on=[].concat(s.l);
    lines.forEach((el,j)=>el.classList.toggle('on',on.includes(j)));
    vis.innerHTML=typeof s.v==='function'?s.v():s.v;
    note.textContent=s.n||'';pos.textContent=(k+1)+' / '+cfg.steps.length;
  }
  function stop(){clearInterval(timer);timer=null;play.textContent=i===last?'Replay':'Play'}
  function start(){
    if(i===last)show(0);
    play.textContent='Pause';
    timer=setInterval(()=>{if(i<last)show(i+1);if(i>=last)stop()},cfg.ms||1500);
  }
  mount.addEventListener('click',e=>{
    const a=e.target.closest('[data-a]');if(!a)return;
    const k=a.dataset.a;
    if(k==='play'){timer?stop():start();return}
    stop();
    if(k==='next')show(i<last?i+1:0);
    if(k==='prev')show(i>0?i-1:last);
    if(k==='reset')show(0);
    play.textContent='Play';
  });
  show(0);
}

