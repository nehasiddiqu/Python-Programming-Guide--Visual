  --mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0B1220; --panel:#121C30; --ink:#E8EDF7; --muted:#9AA7BF; --line:#26324A;
  --blue:#7DB1F5; --on-blue:#0B1220; --ok:#5FD3A0; --bad:#FF8A80; --code:#0A1120; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0B1220; --panel:#121C30; --ink:#E8EDF7; --muted:#9AA7BF; --line:#26324A;
  --blue:#7DB1F5; --on-blue:#0B1220; --ok:#5FD3A0; --bad:#FF8A80; --code:#0A1120; color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 var(--body);
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:28px 72px}
.wrap{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr);gap:20px}
@media(min-width:1000px){.wrap{grid-template-columns:230px minmax(0,1fr);gap:56px}}
h1,h2{font-family:var(--display);letter-spacing:-.015em;text-wrap:balance;margin:0}
code{font-family:var(--mono);font-size:.92em}
