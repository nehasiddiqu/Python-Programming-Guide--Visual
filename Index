  function r(){
    $('#in-c',m).innerHTML=Object.keys(C).map(c=>'<button class="btn '+(c===cls?'sel':'')+'" data-c="'+c+'">'+c+'()</button>').join(' ');
    $('#in-m',m).innerHTML=['speak','eat','fetch','purr'].map(x=>'<button class="btn '+(x===meth?'sel':'')+'" data-m="'+x+'">.'+x+'()</button>').join(' ');
    const ch=chain(cls);let found=null;const hops=[];
    for(const c of ch){const has=c!=='object'&&C[c].m.includes(meth);hops.push([c,has]);if(has){found=c;break}}
    const hh=hops.map(([c,has],i)=>(i?'<span class="arr">→</span>':'')+'<div class="hop '+(has?'yes':'no')+'" style="--d:'+(i*350)+'ms"><b>'+c+'</b><small>'+(has?'has '+meth+'()':'no '+meth+'()')+'</small></div>').join('');
    let res;
    if(!found)res='<div class="cond f">AttributeError: \''+cls+'\' object has no attribute \''+meth+'\'</div>';
    else if(found===cls)res='<div class="cond t">'+(cls!=='Animal'&&C.Animal.m.includes(meth)?cls+' defines its own '+meth+'(), which overrides Animal.'+meth+'().':'Found in '+cls+' itself.')+'</div>';
    else res='<div class="cond t">Not in '+cls+', so Python checks '+found+' and finds it. '+cls+' inherits '+meth+'().</div>';
    $('#in-v',m).innerHTML='<div class="out">'+cls+'().'+meth+'()</div><div class="lab">lookup order</div><div class="hops">'+hh+'</div>'+res;
  }
  m.addEventListener('click',e=>{const a=e.target.closest('[data-c]'),b=e.target.closest('[data-m]');if(a)cls=a.dataset.c;if(b)meth=b.dataset.m;if(a||b)r()});
  r();
};

/* 14 polymorphism */
W.poly=m=>{
  const P=[['Dog','Woof'],['Cat','Meow'],['Duck','Quack']];
  const PO=(k,outs)=>'<div class="pets">'+P.map(([n,s],i)=>'<div class="pet '+(i===k?'on':'')+'">'+n+'()<small>'+(i<=k?s:'')+'</small></div>').join('')+'</div>'+(outs.length?OUT(outs.join('\n')):'');
  const steps=[{l:6,v:()=>PO(-1,[]),n:'A list of three different objects.'}];
  P.forEach(([n,s],k)=>{const o=P.slice(0,k+1).map(p=>p[1]);steps.push({l:7,v:()=>PO(k,o),n:'pet is a '+n+', so pet.speak() runs the '+n+' version and returns "'+s+'".'})});
  stepper(m,{code:['class Dog:','    def speak(self): return "Woof"','class Cat:','    def speak(self): return "Meow"','class Duck:','    def speak(self): return "Quack"','for pet in [Dog(), Cat(), Duck()]:','    print(pet.speak())'],steps,ms:1500});
};

/* 15 encapsulation */
W.bank=m=>{
  const code=['class Account:','    def __init__(self, balance):','        self._balance = balance','','    @property','    def balance(self):','        return self._balance','','    def deposit(self, amount):','        self._balance += amount','','    def withdraw(self, amount):','        if amount > self._balance:','            raise ValueError("Insufficient funds")','        self._balance -= amount'];
  m.innerHTML='<div class="demo"><div class="demo-grid"><div class="code">'+codeHTML(code)+'</div><div class="stage"><div class="bal"><small>acct.balance</small><b id="bk-b">100</b></div><div class="ctl row"><label>amount <input id="bk-n" type="number" min="0" value="30"></label></div><div class="ctl"><button class="btn" data-k="w">withdraw</button><button class="btn" data-k="d">deposit</button><button class="btn" data-k="s">balance = 999</button></div><div class="out" id="bk-l">acct = Account(100)</div></div></div></div>';
  const lines=[...m.querySelectorAll('.ln')];let bal=100,log=['acct = Account(100)'];
  function mark(on,err){lines.forEach((l,i)=>{l.className='ln'+(i===err?' err':on.includes(i)?' on':'')})}
  m.addEventListener('click',e=>{
    const b=e.target.closest('[data-k]');if(!b)return;
    let n=parseInt($('#bk-n',m).value,10);if(Number.isNaN(n)||n<0)n=0;
    const k=b.dataset.k;
    if(k==='w'){
      log.push('>>> acct.withdraw('+n+')');
      if(n>bal){log.push('ValueError: Insufficient funds');mark([11,12],13)}
      else{bal-=n;mark([11,12,14])}
    }else if(k==='d'){bal+=n;log.push('>>> acct.deposit('+n+')');mark([8,9])}
    else{log.push('>>> acct.balance = 999');log.push("AttributeError: property 'balance' of 'Account' object has no setter");mark([4,5],4)}
    log.push('>>> acct.balance  # '+bal);
    log=log.slice(-7);
    const bb=$('#bk-b',m);bb.textContent=bal;bb.style.animation='none';void bb.offsetWidth;bb.style.animation='';bb.style.animation='pop .35s';
    $('#bk-l',m).textContent=log.join('\n');
  });
};

