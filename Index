.hero{padding-block:8px 28px;max-width:46rem}
.hero h1{font-size:clamp(34px,6vw,60px);line-height:1.04;font-weight:700}
.hero p{color:var(--muted);font-size:18px;margin:14px 0 0}
.hero .py{color:var(--blue)}
